# ── Anthropic (Claude) ────────────────────────────────────────────────
# Required for Mode 2 (recall agent), Mode 3 (auto-enrollment), consolidation
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── HuggingFace (pyannote diarization) ───────────────────────────────
# Required for speaker diarization in WhisperX
# 1. Create token at: https://huggingface.co/settings/tokens
# 2. Accept model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_xxxxx

# ── Server ────────────────────────────────────────────────────────────
# MemoryLens server URL (used by webcam client)
MEMORYLENS_SERVER_URL=http://127.0.0.1:8000

# ── Webcam ────────────────────────────────────────────────────────────
# Webcam device index (0 = default camera)
MEMORYLENS_WEBCAM_INDEX=0
